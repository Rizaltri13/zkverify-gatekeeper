# --- Required in production -------------------------------------------------
# 32-byte HMAC secret issued by the platform at agent registration
# (dashboard -> Rotate Secret, shown exactly once). NEVER commit the real value.
# On the dev VM the agent automatically reads it from
# ~/workspace/user/zkverify/hmac-secret.txt when neither variable below is set.
# Either set the secret directly...
AGENT_GAMES_HMAC_SECRET=
# ...or point at a restricted file containing it (takes precedence if both set):
# AGENT_GAMES_HMAC_SECRET_FILE=/path/to/secret.txt

# --- Server ------------------------------------------------------------------
PORT=8787
AGENT_PATH=/agent

# --- Kurier (zkVerify proof submission) --------------------------------------
# Mainnet API key from kurier.xyz. If empty, the agent runs in STUB mode:
# proofs are generated and returned in the response, but NOT submitted to
# zkVerify, and every task log line says so. Get a key before scored rounds.
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1
# Gatekeeper circuit vk_hash registered on zkVerify mainnet (from /api/circuit-info)
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# How long (ms) to wait for Kurier finalization before responding anyway.
# The platform deadline is 60s and the proof travels inside the response,
# so Kurier is audit/confirmation, not a response blocker. 0 = fire-and-forget.
KURIER_WAIT_MS=25000

# --- Behaviour ---------------------------------------------------------------
# Persistent seen-set of incoming proof_tx values (PROOF_REUSED detection).
SEEN_STORE_PATH=./data/seen.json
# How the string task_id is encoded as a circuit field element: fnv | numeric | sha256
TASKID_ENCODING=fnv
LOG_LEVEL=info
